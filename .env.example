# ============================================================================
# lego-claw — главный .env (читается ВСЕМИ launcher'ами).
#
# Сгенерируйте все 5 секретов одной командой ПЕРЕД первым запуском:
#
#   for k in CLAWCODE_ADAPTER_API_KEY OPENHANDS_ADAPTER_API_KEY \
#            OPENCODE_ADAPTER_API_KEY AGENT_REGISTRY_API_KEY \
#            SKILLS_MANAGER_API_KEY; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 32)|" .env
#   done
#
# Все пути по умолчанию используют $HOME — менять не обязательно.
# Полный список ключей и их смысл — см. README.md → "Безопасность".
# ============================================================================

# ─── Environment ────────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO
TZ=Europe/Moscow

# ─── HuggingFace ────────────────────────────────────────────────────────────
HF_TOKEN=your_hf_token_if_needed

# ─── Runtime URLs ────────────────────────────────────────────────────────────
# These host-side defaults match the published ports from docker-compose.
# The app container rewires them to internal service DNS automatically.
# For an external LM Studio running on the host, change LM_STUDIO_URL to
# http://localhost:1234 before starting the stack.
LM_STUDIO_URL=http://localhost:8000
STT_URL=http://localhost:8001
TTS_URL=http://localhost:8880

# ─── OpenTelemetry → Phoenix ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=voice-assistant

# ─── App-in-container overrides ──────────────────────────────────────────────
APP_LM_STUDIO_URL=http://vllm:8000
APP_STT_URL=http://whisper:8000
APP_TTS_URL=http://kokoro-tts:8880
APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4318
APP_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
APP_OTEL_SERVICE_NAME=voice-assistant

# ─── LLM параметры ───────────────────────────────────────────────────────────
LLM_MODEL=gemma-4-31b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
VLLM_MODEL_REPO=coder3101/gemma-4-31B-it-heretic
MAX_CONTEXT_LEN=256000
VLLM_MAX_NUM_SEQS=16
VLLM_MAX_NUM_BATCHED_TOKENS=524288
VLLM_GPU_MEMORY_UTILIZATION=0.82
VLLM_DTYPE=bfloat16
VLLM_KV_CACHE_DTYPE=
VLLM_ATTENTION_BACKEND=
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_ENABLE_TOOLS=1
VLLM_TOOL_CALL_PARSER=hermes

# ─── STT параметры ───────────────────────────────────────────────────────────
STT_MODEL=whisper-1
STT_LANGUAGE=ru
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda

# ─── TTS параметры ───────────────────────────────────────────────────────────
TTS_VOICE=ru_RU-dmitri
TTS_FORMAT=wav
TTS_CHUNK_CHARS=220

# ─── Память диалога ──────────────────────────────────────────────────────────
MEMORY_MAX_TURNS=10
SYSTEM_PROMPT=Ты — голосовой ассистент. Отвечай кратко и по делу.
SYSTEM_PROMPT_PATH=configs/prompts/system.txt

# ─── Voice policy ────────────────────────────────────────────────────────────
STOP_COMMANDS=стоп,тихо,подожди,дополню
PROMPT_VERSION=voice-prompt-v1
POLICY_VERSION=interrupt-policy-v1
TOOL_SCHEMA_VERSION=voice-tool-schema-v1
VERIFIER_VERSION=voice-verifier-v1

# ─── Data policy ─────────────────────────────────────────────────────────────
RAW_AUDIO_ENABLED=false
DEBUG_ARTIFACT_TTL_HOURS=24
TRAJECTORY_STORE_DIR=data/trajectories
DEBUG_ARTIFACT_DIR=data/debug

# ─── Runtime probes ──────────────────────────────────────────────────────────
CANCEL_PROBE_PROMPT=Сосчитай вслух от одного до ста, по одному числу за раз.
CANCEL_PROBE_TOKENS=8

# ─── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_HTTP_PORT=80

# ─── LiteLLM stack (OpenWebUI / OpenHands / Claw) ────────────────────────────
# Canonical chat model_name in docker/litellm/config.yaml — align .env.openwebui,
# .env.openhands, .env.clawcode defaults with this value unless you intentionally split upstreams.
STACK_DEFAULT_LITELLM_CHAT_MODEL=qwen3.6-35b-heretic

# ─── openai-stack-relay (pattern-B demo hop in front of LiteLLM) ────────────
# Loopback host port. Default :8089 (was :8088, moved to free :8088 for the
# host-side llama.cpp launcher). Container internally still listens on :8088.
RELAY_HOST_PORT=8089

# ─── LocalAI ─────────────────────────────────────────────────────────────────
LOCALAI_HOST_PORT=8180
LOCALAI_CONTEXT_SIZE=8192
LMSTUDIO_MODELS_DIR=${HOME}/.lmstudio/models

# ─── Agent-mesh adapters (Track 1: agent-as-tool) ────────────────────────────
# See docs/agent-mesh.md and compose.agents-mesh.yml.
# Bearer tokens — generate fresh values with `openssl rand -hex 32`. Both
# OpenWebUI tool-server registration and LiteLLM A2A targets must use the
# SAME value as the corresponding adapter container.
CLAWCODE_ADAPTER_API_KEY=dev-temp-clawcode-adapter-CHANGE-ME-IN-PRODUCTION-a1b2c3d4e5
OPENHANDS_ADAPTER_API_KEY=dev-temp-openhands-adapter-CHANGE-ME-IN-PRODUCTION-f6g7h8i9j0
# opencode-adapter — ACP-bridged peer for opencode (https://opencode.ai/).
# Rotate with `openssl rand -hex 32`.
OPENCODE_ADAPTER_API_KEY=dev-temp-opencode-adapter-CHANGE-ME-IN-PRODUCTION-k1l2m3n4o5
# Loopback host-ports (127.0.0.1:<port>). Runtime-sandbox of OpenHands
# reaches the adapters via `http://host.docker.internal:<port>`.
CLAWCODE_ADAPTER_HOST_PORT=8790
OPENHANDS_ADAPTER_HOST_PORT=8791
OPENCODE_ADAPTER_HOST_PORT=8798
# Cycle-guard ceiling for nested agent calls. 1 = agent A may delegate to
# agent B, but B cannot delegate further. Raise with care.
MAX_NESTED_AGENT_CALLS=1
# Concurrency caps inside each adapter.
CLAWCODE_ADAPTER_CONCURRENCY=2
OPENHANDS_ADAPTER_CONCURRENCY=1
OPENHANDS_ADAPTER_TIMEOUT=1800
OPENCODE_ADAPTER_CONCURRENCY=2
OPENCODE_ADAPTER_TIMEOUT=1200
# Permission policy applied to opencode's `session/request_permission`
# callbacks. `workspace` (default) auto-approves iff every touched path
# stays inside /workspace/project; `all` approves everything (trusted
# demo only); `none` denies every permission request (strict mode).
OPENCODE_ADAPTER_AUTO_APPROVE=workspace
AGENT_MESH_LOG_LEVEL=info

# ─── A2A-compliant mesh (Section 4: AgentCard / bindings / Tasks) ────────────
# A2A REST is on the same loopback port as /v1/run. gRPC (Section 10) sits
# on its own port so the runtime-sandbox can reach it via
# host.docker.internal:<port>.
CLAWCODE_ADAPTER_GRPC_HOST_PORT=8796
OPENHANDS_ADAPTER_GRPC_HOST_PORT=8797
OPENCODE_ADAPTER_GRPC_HOST_PORT=8799
# Bindings exposed by every adapter. Comma-separated subset of
# {rest, jsonrpc, grpc}. Drop `grpc` if grpcio-tools is unavailable.
A2A_BINDINGS=rest,jsonrpc,grpc
# memory:// (default) keeps tasks in process. Set to a postgres DSN
# (e.g. postgresql://litellm:litellm@litellm-db:5432/litellm) to survive
# restarts. See P2 in plans/a2a-compliant_agent_mesh_*.plan.md.
A2A_TASK_STORE_DSN=memory://
# Push-notification (Section 7.5) dispatcher tuning.
A2A_PUSH_MAX_RETRIES=5
A2A_PUSH_BACKOFF_BASE_S=1.0

# ─── agent-registry (single tool-server fronting all adapters) ───────────────
# Generate fresh: `openssl rand -hex 32`.
AGENT_REGISTRY_API_KEY=dev-temp-agent-registry-CHANGE-ME-IN-PRODUCTION-p6q7r8s9t0
AGENT_REGISTRY_HOST_PORT=8794
# CSV of <agentId>=<host>:<port>. AgentCards are fetched from
# http://<host>:<port>/.well-known/agent-card.json.
AGENT_REGISTRY_AGENTS=clawcode=clawcode-adapter:8790,openhands=openhands-adapter:8791,opencode=opencode-adapter:8798

# ─── skills-manager (CRUD over .ai/skills/) ─────────────────────────────────
# Generate fresh: `openssl rand -hex 32`.
SKILLS_MANAGER_API_KEY=dev-temp-skills-manager-CHANGE-ME-IN-PRODUCTION-u1v2w3x4y5
SKILLS_MANAGER_HOST_PORT=8795
# CSV of <agentId>=<base-url>. Skills-manager POSTs /admin/reload to each
# entry after every write so AgentCard.version bumps.
SKILLS_ADAPTERS=clawcode=http://clawcode-adapter:8790,openhands=http://openhands-adapter:8791,opencode=http://opencode-adapter:8798
