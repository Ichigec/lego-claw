# ─── Mainline backend policy ────────────────────────────────────────────────
# Mainline supports host-side LM Studio only.
# vLLM is archived in legacy/v1-vllm/ because it was memory-inefficient and
# unstable to start reliably in this project.

# ─── Environment ────────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO
TZ=Europe/Moscow

# ─── Runtime URLs ────────────────────────────────────────────────────────────
# LLM: OpenAI-совместимый шлюз LiteLLM → llama-server (см. compose.phoenix.yml, compose.llama.yml).
# С хоста — :4000, из контейнеров той же сети llm-stack-net — http://litellm:4000.
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=sk-local
STT_URL=http://localhost:8001
TTS_URL=http://localhost:8880

# ─── OpenTelemetry → Phoenix ─────────────────────────────────────────────────
# Phoenix: UI :6006, OTLP/gRPC :4317, OTLP/HTTP :4318 (alias на 6006). Используем gRPC,
# чтобы не конфликтовать с UI на 6006.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=voice-assistant
PHOENIX_RETENTION_DAYS=30

# ─── App-in-container overrides ──────────────────────────────────────────────
APP_ENV_FILE=.env.runtime
APP_OPENAI_API_BASE=http://litellm:4000/v1
APP_OPENAI_API_KEY=sk-local
APP_STT_URL=http://whisper:8000
APP_TTS_URL=http://gpu-tts:8880
APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4317
APP_OTEL_EXPORTER_OTLP_PROTOCOL=grpc
APP_OTEL_SERVICE_NAME=voice-assistant

# ─── LLM параметры ───────────────────────────────────────────────────────────
# Alias как он объявлен в llama-server (--alias) и в LiteLLM model_list.
LLM_MODEL=qwen3.6-35b-heretic
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
MAX_CONTEXT_LEN=256000

# ─── STT параметры ───────────────────────────────────────────────────────────
STT_MODEL=whisper-1
STT_LANGUAGE=ru
# Русскоязычная дообученная large-v3 (CT2). Альтернатива: Systran/faster-whisper-large-v3 (99 языков, хуже по чистому RU)
WHISPER_MODEL=Systran/faster-whisper-large-v3
# float16 can raise ValueError on GPU/backends without efficient fp16; use float32 or int8
WHISPER_COMPUTE_TYPE=float32
WHISPER_DEVICE=cuda
WHISPER_GPU_COUNT=1

# ─── GPU TTS runtime ─────────────────────────────────────────────────────────
GPU_TTS_IMAGE=voice-assistant-gpu-tts:local
GPU_TTS_PORT=8880
TTS_GPU_COUNT=1
TTS_DEVICE=cuda
TTS_OTEL_SERVICE_NAME=gpu-tts
PIPER_BIN=piper
PIPER_VOICE_MODELS_DIR=/opt/piper/voices
PIPER_SUPPORTED_VOICES=ru_RU-irina-medium,ru_RU-denis-medium,ru_RU-dmitri-medium,ru_RU-ruslan-medium
PIPER_DEFAULT_VOICE=ru_RU-irina-medium
PIPER_AUTO_DOWNLOAD=true
PIPER_USE_CUDA=true
PIPER_MAX_TEXT_CHARS=2000
PIPER_TIMEOUT_SEC=180

# ─── TTS параметры ───────────────────────────────────────────────────────────
# Список голосов задается в TTS_VOICE_CATALOG_PATH (JSON), UI читает через GET /api/tts/voices.
TTS_VOICE=ru_RU-irina-medium
TTS_SPEECH_MODEL=kokoro
TTS_FORMAT=wav
TTS_CHUNK_CHARS=220
# Минимум символов до отправки онлайн-чанка, чтобы не дробить речь по коротким предложениям.
TTS_MIN_CHUNK_CHARS=90
TTS_VOICE_CATALOG_PATH=configs/voices.ru.json
TTS_TEXT_MAX_CHARS=1200
TTS_SPEAK_RATE_LIMIT_COUNT=12
TTS_SPEAK_RATE_LIMIT_WINDOW_SEC=60

# ─── Память диалога ──────────────────────────────────────────────────────────
MEMORY_MAX_TURNS=10
# Игнорируется, если существует SYSTEM_PROMPT_PATH (ниже) — правьте configs/prompts/system.txt
SYSTEM_PROMPT=Ты — голосовой ассистент. Отвечай только по-русски, кратко и по делу.
SYSTEM_PROMPT_PATH=configs/prompts/system.txt

# ─── Voice policy ────────────────────────────────────────────────────────────
STOP_COMMANDS=стоп,тихо,подожди,дополню
PROMPT_VERSION=voice-prompt-v1
POLICY_VERSION=interrupt-policy-v1
TOOL_SCHEMA_VERSION=voice-tool-schema-v1
VERIFIER_VERSION=voice-verifier-v1

# ─── Data policy ─────────────────────────────────────────────────────────────
RAW_AUDIO_ENABLED=true
DEBUG_ARTIFACT_TTL_HOURS=24
TRAJECTORY_STORE_DIR=data/trajectories
DEBUG_ARTIFACT_DIR=data/debug

# ─── Runtime probes ──────────────────────────────────────────────────────────
CANCEL_PROBE_PROMPT=Сосчитай вслух от одного до ста, по одному числу за раз.
CANCEL_PROBE_TOKENS=8

# ─── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_HTTP_PORT=80
# Прямой доступ к FastAPI на хосте (8080 часто занят VPN); внутри контейнера порт 8080.
APP_HTTP_HOST_PORT=18080
