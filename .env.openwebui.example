# ============================================================================
# lego-claw — OpenWebUI + tool-серверы + host-side Jupyter.
#
# Сгенерируйте 6 секретов одной командой:
#
#   for k in WEBUI_SECRET_KEY SEARXNG_SECRET JUPYTER_TOKEN \
#            SHELLBOX_API_KEY FSBOX_API_KEY SEARCHBOX_API_KEY; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 32)|" .env.openwebui
#   done
#
# Если работаете в одиночку — можно оставить admin email/password пустыми,
# тогда первый зашедший в OpenWebUI станет админом через UI-форму.
# ============================================================================

# ─── OpenWebUI ────────────────────────────────────────────────────────────────
OPENWEBUI_ENABLED=1
OPENWEBUI_HOST_PORT=3000
WEBUI_SECRET_KEY=__GENERATE_WITH_openssl_rand_hex_32__
# Same logical default as STACK_DEFAULT_LITELLM_CHAT_MODEL in .env (see docs/litellm-clients.md).
OPENWEBUI_DEFAULT_MODEL=qwen3.6-35b-heretic
OPENWEBUI_DEFAULT_LOCALE=ru-RU
OPENWEBUI_ENABLE_PERSISTENT_CONFIG=true
OPENWEBUI_ENABLE_LOGIN_FORM=true
OPENWEBUI_ENABLE_SIGNUP=true
OPENWEBUI_ENABLE_API_KEYS=true
OPENWEBUI_ENABLE_OLLAMA_API=false
OPENWEBUI_ENABLE_OPENAI_API=true
OPENWEBUI_OPENAI_API_BASE_URLS=http://litellm:4000/v1
OPENWEBUI_OPENAI_API_KEYS=sk-local

# ─── OpenWebUI audio via LiteLLM -> LocalAI ──────────────────────────────────
# IMPORTANT: with OPENWEBUI_ENABLE_PERSISTENT_CONFIG=true the values below are
# seeded ONLY on a fresh openwebui-data-volume. On an existing volume the audio
# settings live in Admin Panel → Settings → Audio and override these env vars.
# After changing the aliases here, also update them in the Admin Panel (or wipe
# openwebui-data-volume to re-seed). See docs/openwebui.md → "Audio policy".
OPENWEBUI_AUDIO_API_BASE_URL=http://litellm:4000/v1
OPENWEBUI_AUDIO_API_KEY=sk-local
OPENWEBUI_AUDIO_STT_ENGINE=openai
OPENWEBUI_AUDIO_STT_MODEL=stt-whisper-cuda-turbo
OPENWEBUI_AUDIO_STT_CONTENT_TYPES=audio/*,video/webm
OPENWEBUI_AUDIO_TTS_ENGINE=openai
OPENWEBUI_AUDIO_TTS_MODEL=tts-ru-default
# Qwen3-TTS CustomVoice ships a fixed speaker bank: aiden, dylan, eric,
# ono_anna, ryan, serena, sohee, uncle_fu, vivian. `ono_anna` is the closest
# to a clear neutral RU female voice — used as default. Override per-user in
# `User Settings → Audio → TTS Voice` (or per-model in Workspace).
# For tts-piper-ru-fallback the voice is encoded in the model name itself,
# so any non-empty value here is accepted (LiteLLM requires the field).
OPENWEBUI_AUDIO_TTS_VOICE=ono_anna

# ─── Optional headless bootstrap / validation ────────────────────────────────
# If both OPENWEBUI_ADMIN_EMAIL and OPENWEBUI_ADMIN_PASSWORD are set on a fresh
# data volume, OpenWebUI creates the first admin automatically and disables
# signup. Leave them empty for the usual first-login flow via the UI.
OPENWEBUI_ADMIN_NAME=OpenWebUI-Admin
OPENWEBUI_ADMIN_EMAIL=
OPENWEBUI_ADMIN_PASSWORD=

# Optional creds for stack-smoke.sh deep checks. Defaults to the admin values
# above when they are provided.
OPENWEBUI_VALIDATE_EMAIL=
OPENWEBUI_VALIDATE_PASSWORD=

# ─── Web Search via SearXNG ──────────────────────────────────────────────────
# OpenWebUI talks to the in-cluster SearXNG service over llm-stack-net.
# The host port (SEARXNG_HOST_PORT) is only used for direct curl smoke-tests.
OPENWEBUI_ENABLE_WEB_SEARCH=true
OPENWEBUI_WEB_SEARCH_ENGINE=searxng
# NOTE: Do NOT source this file directly with bash (`source .env.openwebui`),
# because `<query>&format=json` will be misinterpreted as shell redirection.
# stack-start.sh / stack-smoke.sh use a line-parser that handles this correctly.
OPENWEBUI_SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>&format=json
OPENWEBUI_WEB_SEARCH_RESULT_COUNT=5
OPENWEBUI_WEB_SEARCH_CONCURRENT=10

SEARXNG_HOST_PORT=8081
SEARXNG_BASE_URL=http://localhost:8081/
SEARXNG_INSTANCE_NAME=OpenWebUI SearXNG

# ─── OpenHands / Claw / LiteLLM banners ───────────────────────────────────────
# Surfaces pinned links inside OpenWebUI. Honoured by WEBUI_BANNERS
# PersistentConfig (seeded only on a fresh openwebui-data-volume; later edits
# live in Admin Panel → Settings → Banners and override env). Markdown is rendered.
# Set OPENWEBUI_BANNERS=[] to disable. Match OPENWEBUI_OPENHANDS_HOST_PORT to
# OPENHANDS_HOST_PORT in .env.openhands; OPENWEBUI_LITELLM_HOST_PORT to LITELLM_HOST_PORT in .env.
OPENWEBUI_OPENHANDS_HOST_PORT=3300
OPENWEBUI_LITELLM_HOST_PORT=4000
OPENWEBUI_BANNERS=[{"id":"openhands","type":"info","title":"OpenHands","content":"Локальный GUI-агент: [http://localhost:3300](http://localhost:3300). Запуск: `bash openhands-start.sh`. Делегирование как tool через `openhands-adapter` (см. `docs/agent-mesh.md`).","dismissible":true,"timestamp":0},{"id":"clawcode","type":"info","title":"Claw Code (CLI)","content":"CLI-агент без Web UI: `bash clawcode-start.sh` — см. `docs/clawcode.md`. В чате доступен как tool `clawcode-adapter` и LiteLLM-алиас `agent/clawcode` (см. `docs/agent-mesh.md`).","dismissible":true,"timestamp":0},{"id":"litellm-ui","type":"info","title":"LiteLLM","content":"Шлюз моделей и админ UI: [http://localhost:4000/ui](http://localhost:4000/ui). Логин/пароль: `LITELLM_UI_USERNAME` / `LITELLM_UI_PASSWORD` в `.env`. Если меняли `LITELLM_HOST_PORT`, поправьте URL здесь или в Admin → Banners.","dismissible":true,"timestamp":0}]
# 32-byte hex; rotate with `openssl rand -hex 32` before pushing to a real env.
SEARXNG_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# ─── Code Execution / Code Interpreter via host-side Jupyter ─────────────────
# OpenWebUI reaches the host-side jupyter_server through host.docker.internal,
# which compose.openwebui.yml wires up via extra_hosts.
OPENWEBUI_ENABLE_CODE_EXECUTION=true
OPENWEBUI_ENABLE_CODE_INTERPRETER=true
OPENWEBUI_CODE_EXECUTION_ENGINE=jupyter
OPENWEBUI_CODE_EXECUTION_JUPYTER_URL=http://host.docker.internal:8888
OPENWEBUI_CODE_EXECUTION_JUPYTER_AUTH=token
OPENWEBUI_CODE_EXECUTION_JUPYTER_TIMEOUT=30
OPENWEBUI_CODE_INTERPRETER_ENGINE=jupyter
OPENWEBUI_CODE_INTERPRETER_JUPYTER_URL=http://host.docker.internal:8888
OPENWEBUI_CODE_INTERPRETER_JUPYTER_AUTH=token
OPENWEBUI_CODE_INTERPRETER_JUPYTER_TIMEOUT=30

# Shared with jupyter-host-start.sh; the same token is injected into the
# kernel server config so OpenWebUI ↔ Jupyter auth lines up automatically.
JUPYTER_TOKEN=__GENERATE_WITH_openssl_rand_hex_32__
JUPYTER_HOST=127.0.0.1
JUPYTER_PORT=8888
# Working tree the kernel can read/write. Default = the code-agent sandbox,
# so OpenWebUI's Code Interpreter writes land in the same place as fsbox.
# Override (e.g. ${HOME}/lego-claw) for one-off data crunching only.
JUPYTER_ROOT_DIR=${HOME}/agent_dev

# ─── CLI sandbox (mcpo + mcp-shell-server) ───────────────────────────────────
SHELLBOX_HOST_PORT=8021
SHELLBOX_API_KEY=__GENERATE_WITH_openssl_rand_hex_32__

# ─── FS sandbox (mcpo + @modelcontextprotocol/server-filesystem) ─────────────
# fsbox exposes a typed filesystem API (read_file/write_file/edit_file/...)
# rooted at ${HOME}/agent_dev (rw). Used by OpenWebUI as a code-agent
# OpenAPI tool. See docs/openwebui-tools.md → «Code-агент».
FSBOX_HOST_PORT=8022
FSBOX_API_KEY=__GENERATE_WITH_openssl_rand_hex_32__

# ─── Multi-engine MCP search (searchbox) ─────────────────────────────────────
# searchbox combines our own FastMCP server (SearXNG, Wikipedia, arXiv, GitHub,
# HN, StackExchange, Crossref/OpenAlex, PyPI/NPM, DuckDuckGo, + optional
# Brave/Google/Tavily) behind:
#   - mcpo on :8001 — OpenAPI for OpenWebUI (external tool over llm-stack-net).
#   - native MCP   on :8090 — Streamable HTTP (/mcp) + SSE (/sse) for OpenHands,
#                              Cursor, Claude Desktop.
# See mcp/README.md and docs/openwebui-tools.md → «5. Multi-engine Search».
SEARCHBOX_HOST_PORT=8023
SEARCHBOX_MCP_HOST_PORT=8024
# 32-byte hex; rotate with `openssl rand -hex 32` if exposing the OpenAPI
# endpoint outside localhost. OpenWebUI sends this as `Authorization: Bearer`.
SEARCHBOX_API_KEY=__GENERATE_WITH_openssl_rand_hex_32__
# SearXNG backend URL (inside llm-stack-net). Override only if you host
# SearXNG elsewhere.
SEARCHBOX_SEARXNG_URL=http://searxng:8080
# Optional per-engine credentials. Unset → the engine is marked unavailable
# in search_status but doesn't crash the stack.
# BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CX=
# GITHUB_TOKEN=
# TAVILY_API_KEY=
# STACKEXCHANGE_KEY=
# OPENALEX_MAILTO=
# Per-engine timeout (seconds) and log level.
SEARCHBOX_HTTP_TIMEOUT=10
SEARCHBOX_LOG_LEVEL=INFO
