# ─── OpenHands ────────────────────────────────────────────────────────────────
# Knobs for compose.openhands.yml + openhands-start.sh.
# Sourced AFTER .env, so anything here can override values from .env.

# Host port for the OpenHands GUI. 3000 is already taken by OpenWebUI, so
# we default to 3300. Pick anything free if you need to colocate more UIs.
OPENHANDS_HOST_PORT=3300

# App image. The :1.6 floating tag tracks the latest 1.6.x patch release per
# https://docs.all-hands.dev/usage/local-setup. Pin to a specific version
# (e.g. docker.openhands.dev/openhands/openhands:1.6.0) for byte-identical
# reproducibility, or to fall back to a different arch tag on aarch64.
OPENHANDS_IMAGE=docker.openhands.dev/openhands/openhands:1.6

# V1 sandbox runtime image. The pair (1.6 ↔ 1.15.0-python) is the version
# combo from the official quickstart; mismatches cause «exec format error»
# (see https://github.com/All-Hands-AI/OpenHands/issues/3525).
OPENHANDS_AGENT_SERVER_REPO=ghcr.io/openhands/agent-server
OPENHANDS_AGENT_SERVER_TAG=1.15.0-python

# Default model alias as it appears in docker/litellm/config.yaml.
# Keep in sync with STACK_DEFAULT_LITELLM_CHAT_MODEL in .env and with
# OPENWEBUI_DEFAULT_MODEL / CLAWCODE_DEFAULT_MODEL (docs/litellm-clients.md).
# Uses host-side llama.cpp via LiteLLM (alias qwen3.6-35b-heretic). For LM
# Studio MoE instead, set tvall43-qwen3.6-35b-a3b-heretic (still in config.yaml).
OPENHANDS_DEFAULT_MODEL=qwen3.6-35b-heretic

# Where the agent edits files on the host. Defaults to the shared agent
# sandbox (same path fsbox + Jupyter use) so the whole stack works on the
# same tree. Override to isolate OpenHands from the rest of the stack.
OPENHANDS_WORKSPACE_DIR=${HOME}/agent_dev

# Persistent app state (sessions, MCP tokens, conversation history).
# Lives outside the repo so vendored sources stay clean.
#
# NOTE: our env parser (load_selected_env in openhands-start.sh) treats values
# literally — it does NOT expand $HOME / ${HOME}. Use an absolute path, or
# leave the line commented out and the launcher will pick a sensible default
# (home of the invoking user; when launched as root, home of the repo owner).
OPENHANDS_STATE_DIR=${HOME}/.openhands

# Where OpenHands talks to LiteLLM.
#
# We deliberately use host.docker.internal (NOT the compose DNS `litellm`),
# because OpenHands spawns its runtime sandboxes via docker.sock and they
# join the default bridge network, where `litellm` does not resolve. Both
# the app container and the sandboxes have `host.docker.internal` wired
# through extra_hosts, so this address works from both.
OPENHANDS_LITELLM_BASE_URL=http://host.docker.internal:4000/v1

# Falls back to LITELLM_API_KEY from .env if left empty.
OPENHANDS_LITELLM_API_KEY=

# LOG_ALL_EVENTS=true streams every agent event to docker logs (very useful
# for debugging tool-use loops). Set to false for quieter production runs.
OPENHANDS_LOG_ALL_EVENTS=true

# ─── Agent-mesh MCP servers ──────────────────────────────────────────────────
# JSON list consumed by OpenHands as `MCP_SERVERS` env. The runtime-sandbox
# spawned by docker.sock sits on the default bridge net and therefore can NOT
# resolve compose-DNS names like `clawcode-adapter`; we use the loopback
# host-port published by compose.agents-mesh.yml via host.docker.internal.
# Defaults align with the (`searchbox` + `clawcode-adapter` + `opencode-adapter`)
# trio. `opencode-adapter` is reached the same way — host.docker.internal +
# OPENCODE_ADAPTER_HOST_PORT loopback published by compose.agents-mesh.yml.
#
# ⚠ Self-loop guard: OpenHands MUST NOT see `openhands-adapter` here, the
# adapter's `X-Agent-Mesh-Depth ≥ MAX_NESTED_AGENT_CALLS` check would refuse
# the call anyway, but listing it would invite the LLM to even try.
OPENHANDS_MCP_SERVERS=[{"name":"searchbox","type":"sse","url":"http://host.docker.internal:8024/sse"},{"name":"clawcode-adapter","type":"sse","url":"http://host.docker.internal:8790/sse"},{"name":"opencode-adapter","type":"sse","url":"http://host.docker.internal:8798/sse"}]
