# ─── Claw Code ────────────────────────────────────────────────────────────────
# Knobs for compose.clawcode.yml + clawcode-start.sh / clawcode-stop.sh.
# Sourced AFTER .env, so anything here can override values from .env.
#
# Отдельное имя compose-проекта, чтобы `docker compose -f compose.clawcode.yml`
# не помечал контейнеры основного стека (litellm, open-web-ui, …) как orphans.
CC_COMPOSE_PROJECT=clawcode
#
# Project: https://claw-code.codes/  (заявлен как clean-room rewrite Claude Code,
# март 2026). Ландинг сам предупреждает о supply-chain риске на смежном пакете
# `axios` — поэтому фиксируем конкретный git ref/SHA в CLAWCODE_GIT_REF и
# никогда не пробрасываем docker.sock внутрь контейнера.

# Hostport for an optional HTTP debug endpoint (Claw Code не имеет web-GUI;
# порт зарезервирован под будущие /metrics или /debug).
CLAWCODE_HOST_PORT=3401

# Локально собираемый образ (см. docker/clawcode/Dockerfile). При желании
# можно пинить публичный pre-built образ, но репо не публикует таких тегов.
CLAWCODE_IMAGE=voice-assistant-clawcode:local

# Git repo и pin'нутый ref. Меняйте на конкретный SHA перед merge.
CLAWCODE_GIT_REPO=https://github.com/instructkr/claw-code.git
CLAWCODE_GIT_REF=main

# Rust `claw` требует синтаксис provider/model (например openai/…). LiteLLM
# должен иметь такой же model_name в config.yaml — см. openai/qwen3.6-35b-heretic.
# Короткий алиас qwen3.6-35b-heretic оставьте для OpenWebUI / curl.
CLAWCODE_DEFAULT_MODEL=openai/qwen3.6-35b-heretic

# Workspace bind-mount: тот же sandbox, что у OpenHands и fsbox, чтобы
# три агента видели одно дерево. Изолируйте под отдельный каталог, если
# нужна полная изоляция от code-агента OpenWebUI.
CLAWCODE_WORKSPACE_DIR=${HOME}/agent_dev

# Persistent state (история сессий, MCP token cache). Вне репо.
CLAWCODE_STATE_DIR=${HOME}/.clawcode

# Где Claw Code ищет LiteLLM. По умолчанию — DNS внутри llm-stack-net.
# Если запускаете контейнер вне нашей сети, переключите на
# http://host.docker.internal:4000/v1.
CLAWCODE_LITELLM_BASE_URL=http://litellm:4000/v1

# Falls back to LITELLM_API_KEY when empty.
CLAWCODE_LITELLM_API_KEY=

# UID/GID, под которым контейнер пишет в workspace. Должны совпадать с
# user'ом, имеющим rwx на CLAWCODE_WORKSPACE_DIR (или применяйте setfacl).
CLAWCODE_USER_UID=10101
CLAWCODE_USER_GID=10101

# JSON-список MCP-серверов, которые Claw Code подцепит при старте.
# По умолчанию:
#   * searchbox — multi-engine MCP search (compose.searchbox.yml);
#   * openhands-adapter — agent-mesh адаптер OpenHands (compose.agents-mesh.yml).
#   * opencode-adapter — agent-mesh адаптер opencode (ACP via stdio), см.
#     docs/opencode.md.
#
# Cycle-guard ⚠: Claw НЕ должен видеть собственного адаптера (`clawcode-adapter`),
# иначе LLM может рекурсивно вызвать сам себя. Поэтому ниже только OpenHands и
# opencode. Header `X-Agent-Mesh-Depth` на стороне адаптера тоже ставит верхний
# предел (`MAX_NESTED_AGENT_CALLS` в .env, по умолчанию 1) — см.
# docs/agent-mesh.md.
#
# Для OpenHands- и opencode-адаптеров используются их compose-DNS-имена — Claw
# сидит на `llm-stack-net`, так что оба адаптера ему видны напрямую (тот же
# transport-уровень, что и searchbox).
CLAWCODE_MCP_SERVERS=[{"name":"searchbox","type":"sse","url":"http://searchbox:8090/sse"},{"name":"openhands-adapter","type":"sse","url":"http://openhands-adapter:8791/sse"},{"name":"opencode-adapter","type":"sse","url":"http://opencode-adapter:8798/sse"}]
