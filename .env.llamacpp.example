# Overrides for running Qwen through host-side llama.cpp **alongside** LM Studio.
# stack-start.sh and stack-smoke.sh load this file after .env.
#
# LLM_BACKEND=both       — healthcheck both upstreams on stack start
# LLM_BACKEND=llamacpp   — only llama-server is required
# LLM_BACKEND=lmstudio   — only LM Studio is required (default in .env)
LLM_BACKEND=lmstudio

# LiteLLM `LLAMA_CPP_*` — for model_list entries that still point at llama-server.
# Aliases `qwen3.6-35b-heretic` / `openai/qwen3.6-35b-heretic` now use LM Studio
# (docker/litellm/config.yaml). If you run `llamacpp-host-start.sh`, keep :8090
# here or set LLAMA_CPP_PORT and matching LLAMA_CPP_API_BASE.
LLAMA_CPP_API_BASE=http://host.docker.internal:8090/v1
LLAMA_CPP_API_KEY=llama-cpp

# LM Studio keeps its own port; do not redirect LMSTUDIO_* here anymore.
LMSTUDIO_MODEL_ID=tvall43-qwen3.6-35b-a3b-heretic
PUBLIC_MODEL_ALIAS=tvall43-qwen3.6-35b-a3b-heretic

# llama.cpp launch parameters.
# Эти значения 1-в-1 повторяют живой запуск LM Studio v0.4.12 на этом хосте
# (server-logs/2026-05-01.1.log) — конфигурация, дающая ~677 t/s prefill /
# ~16.8 t/s decode на Qwen3.6-35B-A3B-Heretic / GB10 (sm_121, CUDA 13.2).
LLAMA_CPP_DIR=${HOME}/dev/llama.cpp
LLAMA_CPP_SERVER_BIN=${HOME}/dev/llama.cpp/build/bin/llama-server
LLAMA_CPP_MODEL_PATH=${HOME}/.lmstudio/models/CCSSNE/tvall43-Qwen3.6-35B-A3B-heretic-gguf/Qwen3.6-35B-A3B-heretic-bf16.gguf
LLAMA_CPP_MMPROJ_PATH=${HOME}/.lmstudio/models/CCSSNE/tvall43-Qwen3.6-35B-A3B-heretic-gguf/Qwen3.6-35B-A3B-heretic-mmproj-F32.gguf
LLAMA_CPP_HOST=0.0.0.0
LLAMA_CPP_PORT=8090
LLAMA_CPP_CTX_SIZE=262144
# 41 = все слои модели + output (LM Studio: "n_gpu_layers": 41).
# 999 тоже работает (llama.cpp клампит до максимума), оставляем точное число.
LLAMA_CPP_GPU_LAYERS=41
LLAMA_CPP_THREADS=20
LLAMA_CPP_BATCH_SIZE=512
LLAMA_CPP_UBATCH_SIZE=512
LLAMA_CPP_PARALLEL=4
LLAMA_CPP_ALIAS=qwen3.6-35b-heretic
LLAMA_CPP_FLASH_ATTN=on
LLAMA_CPP_MLOCK=0
# I/O: LM Studio грузит модель через --no-mmap + --direct-io.
# direct-io неявно отключает mmap, но держим явно для читаемости.
LLAMA_CPP_MMAP=off
LLAMA_CPP_DIRECT_IO=on
# Unified KV cache (LM Studio: Unified KV Cache = on). По умолчанию llama.cpp
# включает unified только при auto-slots; здесь форсируем on, чтобы было одинаково
# с LM Studio и не зависело от parallel/slots.
LLAMA_CPP_KV_UNIFIED=on
# MoE-эксперты: 0 = все на GPU (как у LM Studio: «Number of layers forcing MoE
# onto CPU = 0»). Это убирает CPU-вычисления у MoE-моделей вроде Qwen3.6-A3B.
# Если упрётесь в VRAM, поднимайте по 4-8 за шаг (часть слоёв уйдёт на CPU).
# Спецзначения: all|cpu = все эксперты на CPU (--cpu-moe), auto = дефолт llama.cpp.
LLAMA_CPP_N_CPU_MOE=0
# Jinja chat templates — нужны для tool_use и нативного chat-template Qwen3.6.
LLAMA_CPP_JINJA=on
