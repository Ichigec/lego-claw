# ============================================================================
# .env.dify.example — настройки нашего «обёрточного» слоя над Dify.
#
# Скопируйте в .env.dify (`cp .env.dify.example .env.dify`) и заполните
# реальными значениями ПОСЛЕ первого запуска `bash dify-start.sh` —
# Console Token берётся в Dify UI → Settings → Profile → API Keys.
#
# Это НЕ заменяет dify/docker/.env (там upstream-секреты Dify: SECRET_KEY,
# DB_PASSWORD, и т.д.). См. dify/docker/.env.example — он vendored.
# ============================================================================

# ─── Loopback host port для Dify nginx ──────────────────────────────────────
# По умолчанию 8090. Должно совпадать с DIFY_HOST_PORT в compose.dify.yml.
DIFY_HOST_PORT=8090

# ─── Console Token для админ-API Dify ───────────────────────────────────────
# Получить можно ТОЛЬКО через UI после первого логина:
#   1. Откройте http://localhost:8090 → создайте admin
#   2. Settings → Profile → API Keys → Create new
#   3. Скопируйте сюда (формат: app-XXXXXXXX...)
#
# Используется scripts/dify-register-litellm.sh и
# scripts/dify-register-agent-mesh.sh для авто-регистрации провайдера
# и Custom Tools без ручных кликов в UI.
DIFY_CONSOLE_TOKEN=

# ─── (Опционально) Альтернатива: email/password для headless логина ────────
# Если console token получать неудобно (например в CI), скрипты могут
# залогиниться напрямую и сами сгенерировать JWT. Заполните только если
# создавали admin через .env (а не через UI-форму).
DIFY_ADMIN_EMAIL=
DIFY_ADMIN_PASSWORD=

# ─── Алиас модели LiteLLM, который Dify будет регистрировать как провайдер ──
# Должен совпадать с model_name в docker/litellm/config.yaml.
# Менять только если используете не-каноническую модель в стеке.
DIFY_LITELLM_DEFAULT_MODEL=qwen3.6-35b-heretic
DIFY_LITELLM_BASE_URL=http://litellm:4000/v1
# Bearer-токен LiteLLM master key (повтор LITELLM_API_KEY из .env, дублируем
# здесь для удобства scripts/dify-register-litellm.sh).
DIFY_LITELLM_API_KEY=sk-local
