# ─── opencode ────────────────────────────────────────────────────────────────
# Knobs for compose.opencode.yml + opencode-start.sh / opencode-stop.sh.
# Sourced AFTER .env, so anything here can override values from .env.
#
# Отдельное имя compose-проекта, чтобы `docker compose -f compose.opencode.yml`
# не помечал контейнеры основного стека (litellm, open-web-ui, …) как orphans.
OPENCODE_COMPOSE_PROJECT=opencode

# Project: https://opencode.ai/  (terminal-native coding agent; native
# `opencode acp` JSON-RPC bridge). В отличие от Claw, opencode умеет
# Agent Client Protocol (ACP) изкоробки — поэтому opencode-adapter
# не парсит stdout, а ведёт двусторонний JSON-RPC поверх `docker exec -i`.

# Локально собираемый образ — см. docker/opencode/Dockerfile.
OPENCODE_IMAGE=voice-assistant-opencode:local

# Версия opencode (передаётся в install script через OPENCODE_VERSION).
# Пустое значение = latest (рекомендуется пинить SHA/тег перед merge).
OPENCODE_VERSION=

# Базовый Node.js (opencode распространяется как JS-бинарь поверх Node).
OPENCODE_NODE_VERSION=22

# Workspace bind-mount: тот же sandbox, что у clawcode/openhands/fsbox.
OPENCODE_WORKSPACE_DIR=${HOME}/agent_dev

# Persistent state (история сессий, MCP token cache, indexes). Вне репо.
OPENCODE_STATE_DIR=${HOME}/.opencode

# Скиллы (`.ai/`) — read-only mount внутри контейнера.
OPENCODE_SKILLS_DIR=./.ai

# Default model для TUI/REPL. `provider/model` синтаксис opencode (см.
# opencode.json: provider.litellm.models). Должен быть alias в LiteLLM.
OPENCODE_DEFAULT_MODEL=litellm/qwen3.6-35b-heretic

# Где opencode ищет LiteLLM. По умолчанию — DNS внутри llm-stack-net.
OPENCODE_LITELLM_BASE_URL=http://litellm:4000/v1

# Falls back to LITELLM_API_KEY when empty.
OPENCODE_LITELLM_API_KEY=

# UID/GID, под которым контейнер пишет в workspace. Должны совпадать с
# user'ом, имеющим rwx на OPENCODE_WORKSPACE_DIR (или применяйте setfacl).
# Сдвинуто на +1 относительно clawcode (10101) — чтобы оба uid'а могли
# жить рядом в ACL без коллизий.
OPENCODE_USER_UID=10102
OPENCODE_USER_GID=10102

# Дополнительные LSP-серверы (CSV: rust,go). pyright + ts-language-server
# уже включены минимальным набором. См. docker/opencode/Dockerfile.
OPENCODE_EXTRA_LSP=

# Опубликовать `opencode web` UI на 127.0.0.1:<port> рядом с OpenHands
# UI (:3300). Запускается отдельной opencode-web-start.sh.
OPENCODE_WEB_HOST_PORT=3400

# JSON-список MCP-серверов, которые opencode подцепит при старте.
# По умолчанию:
#   * searchbox — multi-engine MCP search (compose.searchbox.yml);
#   * clawcode-adapter — agent-mesh адаптер Claw Code;
#   * openhands-adapter — agent-mesh адаптер OpenHands.
#
# Cycle-guard ⚠: opencode НЕ должен видеть собственного `opencode-adapter`,
# иначе LLM может рекурсивно дёрнуть сам себя. Header X-Agent-Mesh-Depth
# на стороне адаптера тоже ставит верхний предел (MAX_NESTED_AGENT_CALLS
# в .env, по умолчанию 1) — см. docs/agent-mesh.md.
#
# opencode + adapter живут на llm-stack-net, поэтому compose-DNS-имена
# `clawcode-adapter` / `openhands-adapter` видны напрямую (тот же
# transport-уровень, что и у Claw).
OPENCODE_MCP_SERVERS=[{"name":"searchbox","type":"sse","url":"http://searchbox:8090/sse"},{"name":"clawcode-adapter","type":"sse","url":"http://clawcode-adapter:8790/sse"},{"name":"openhands-adapter","type":"sse","url":"http://openhands-adapter:8791/sse"}]
